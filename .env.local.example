# Copy this file to .env.local and fill in your Sanity project details.
# Get these from https://www.sanity.io/manage after creating a free project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Get this from https://resend.com/api-keys — used to send Contact form
# submissions as email. Without it, submissions are just logged, not sent.
RESEND_API_KEY=
